          "afterLine": 63,
          "text": "def stream_with_context("
        },
        {
          "id": "E0044",
          "kind": "context",
          "beforeLine": 63,
          "afterLine": 64,
          "text": "    generator_or_function: t.Iterator[t.AnyStr] | t.Callable[..., t.Iterator[t.AnyStr]],"
        },
        {
          "id": "E0045",
          "kind": "context",
          "beforeLine": 64,
          "afterLine": 65,
          "text": ") -> t.Iterator[t.AnyStr] | t.Callable[[t.Iterator[t.AnyStr]], t.Iterator[t.AnyStr]]:"
        },
        {
          "id": "E0046",
          "kind": "removed",
          "beforeLine": 65,
          "afterLine": null,
          "text": "    \"\"\"Request contexts disappear when the response is started on the server."
        },
        {
          "id": "E0047",
          "kind": "removed",
          "beforeLine": 66,
          "afterLine": null,
          "text": "    This is done for efficiency reasons and to make it less likely to encounter"
        },
        {
          "id": "E0048",
          "kind": "removed",
          "beforeLine": 67,
          "afterLine": null,
          "text": "    memory leaks with badly written WSGI middlewares.  The downside is that if"
        },
        {
          "id": "E0049",
          "kind": "removed",
          "beforeLine": 68,
          "afterLine": null,
          "text": "    you are using streamed responses, the generator cannot access request bound"
        },
        {
          "id": "E0050",
          "kind": "removed",
          "beforeLine": 69,
          "afterLine": null,
          "text": "    information any more."
        },
        {
          "id": "E0051",
          "kind": "added",
          "beforeLine": null,
          "afterLine": 66,
          "text": "    \"\"\"Wrap a response generator function so that it runs inside the current"
        },
        {
          "id": "E0052",
          "kind": "added",
          "beforeLine": null,
          "afterLine": 67,
          "text": "    request context. This keeps :data:`request`, :data:`session`, and :data:`g`"
        },
        {
          "id": "E0053",
          "kind": "added",
          "beforeLine": null,
          "afterLine": 68,
          "text": "    available, even though at the point the generator runs the request context"
        },
        {
          "id": "E0054",
          "kind": "added",
          "beforeLine": null,
          "afterLine": 69,
          "text": "    will typically have ended."
        },
        {
          "id": "E0055",
          "kind": "context",
          "beforeLine": 70,
          "afterLine": 70,
          "text": ""
        },
        {
          "id": "E0056",
          "kind": "removed",
          "beforeLine": 71,
          "afterLine": null,
