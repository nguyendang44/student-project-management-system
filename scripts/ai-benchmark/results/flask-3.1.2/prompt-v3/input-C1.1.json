{
  "claim": {
    "id": "C1.1",
    "text": "Điều chỉnh stream_with_context để lưu app context và request context trước khi tiếp tục generator, rồi đẩy app context trước request context.",
    "originalText": "Điều chỉnh stream_with_context để lưu app context và request context trước khi tiếp tục generator, rồi đẩy app context trước request context.",
    "terms": [
      "app_ctx",
      "req_ctx",
      "yield None"
    ]
  },
